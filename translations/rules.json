{
  "rules": [
    {
      "pattern": "\\ANEW GAME \\+(?<count>[0-9]+)(?<random> \\?\\?\\?)?\\z",
      "replacement": "НОВАЯ ИГРА +${count}${random}"
    },
    {
      "pattern": "\\AFOV \\[(?<value>[-+]?[0-9]+(?:[.,][0-9]+)?)\\]\\z",
      "replacement": "УГОЛ ОБЗОРА [${value}]"
    },
    {
      "pattern": "\\AHealth\\s*:\\s*(?<value>[-+]?[0-9]+(?:[.,][0-9]+)?)\\z",
      "replacement": "Здоровье: ${value}"
    },
    {
      "pattern": "\\AAmmo\\s*:\\s*(?<loaded>[0-9]+)\\s*/\\s*(?<reserve>[0-9]+)\\z",
      "replacement": "Патроны: ${loaded} / ${reserve}"
    },
    {
      "pattern": "\\AAmmo\\s*:\\s*(?<reserve>[0-9]+)\\z",
      "replacement": "Патроны: ${reserve}"
    },
    {
      "pattern": "\\AHunger\\s*:\\s*(?<value>[-+]?[0-9]+(?:[.,][0-9]+)?)\\z",
      "replacement": "Голод: ${value}"
    },
    {
      "pattern": "\\AThirst\\s*:\\s*(?<value>[-+]?[0-9]+(?:[.,][0-9]+)?)\\z",
      "replacement": "Жажда: ${value}"
    },
    {
      "pattern": "\\AWarmup Time\\s*:\\s*(?<value>[-+]?[0-9]+(?:[.,][0-9]+)?)\\z",
      "replacement": "До начала: ${value}"
    },
    {
      "pattern": "\\AWave (?<wave>[0-9]+) - Remaining\\s*:\\s*(?<remaining>[0-9]+)\\z",
      "replacement": "Волна ${wave} — осталось: ${remaining}"
    },
    {
      "pattern": "\\ATime:\\s*(?<clock>[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)\\s*[Aa][Mm]\\z",
      "replacement": "Время: ${clock} до полудня"
    },
    {
      "pattern": "\\ATime:\\s*(?<clock>[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)\\s*[Pp][Mm]\\z",
      "replacement": "Время: ${clock} после полудня"
    },
    {
      "pattern": "\\ATime:\\s*(?<clock>[0-9]{1,2}:[0-9]{2}(?::[0-9]{2})?)\\z",
      "replacement": "Время: ${clock}"
    },
    {
      "pattern": "\\A(?<count>[0-9]+) sets of lockpicks with a pick and a turner\\. They look very brittle\\.\\z",
      "replacement": "Наборов отмычек: ${count}. В каждом — отмычка и натяжитель. Выглядят очень хрупкими."
    },
    {
      "pattern": "\\A(?<nickname>[^\\r\\n]{1,128}) has died\\z",
      "replacement": "Игрок ${nickname} погиб"
    },
    {
      "pattern": "\\A(?<nickname>[^\\r\\n]{1,128}): Help me!\\z",
      "replacement": "${nickname}: Помогите!"
    },
    {
      "pattern": "\\AINVERT\\ Y \\[ON\\]\\z",
      "replacement": "ИНВЕРСИЯ Y [ВКЛ.]"
    },
    {
      "pattern": "\\AINVERT\\ Y \\[OFF\\]\\z",
      "replacement": "ИНВЕРСИЯ Y [ВЫКЛ.]"
    },
    {
      "pattern": "\\AFILM\\ GRAIN \\[ON\\]\\z",
      "replacement": "ЗЕРНИСТОСТЬ [ВКЛ.]"
    },
    {
      "pattern": "\\AFILM\\ GRAIN \\[OFF\\]\\z",
      "replacement": "ЗЕРНИСТОСТЬ [ВЫКЛ.]"
    },
    {
      "pattern": "\\AMOTION\\ BLUR \\[ON\\]\\z",
      "replacement": "РАЗМЫТИЕ В ДВИЖЕНИИ [ВКЛ.]"
    },
    {
      "pattern": "\\AMOTION\\ BLUR \\[OFF\\]\\z",
      "replacement": "РАЗМЫТИЕ В ДВИЖЕНИИ [ВЫКЛ.]"
    },
    {
      "pattern": "\\ARANDOM\\ ENEMIES \\[ON\\]\\z",
      "replacement": "СЛУЧАЙНЫЕ ВРАГИ [ВКЛ.]"
    },
    {
      "pattern": "\\ARANDOM\\ ENEMIES \\[OFF\\]\\z",
      "replacement": "СЛУЧАЙНЫЕ ВРАГИ [ВЫКЛ.]"
    },
    {
      "pattern": "\\AGRAIN\\ AND\\ BLUR \\[ON\\]\\z",
      "replacement": "ЗЕРНО И РАЗМЫТИЕ [ВКЛ.]"
    },
    {
      "pattern": "\\AGRAIN\\ AND\\ BLUR \\[OFF\\]\\z",
      "replacement": "ЗЕРНО И РАЗМЫТИЕ [ВЫКЛ.]"
    },
    {
      "pattern": "\\A(?<indent>[ \\t]*)(?<date>[0-9]{1,4}(?:[./-][0-9]{1,4}){2})\\n\\n[ \\t]*I waited in the dark for so long\\.\\n[ \\t]*I lashed out against anyone who got close\\.\\n\\n[ \\t]*But someone kept pushing me into the light\\.\\n[ \\t]*It hurt me for a while\\.\\n\\n[ \\t]*It doesn[\\u2019\\x27]t hurt anymore\\.\\z",
      "replacement": "${indent}${date}\n\n     Я так долго ждала во тьме.\n     Я бросалась на каждого, кто подходил ближе.\n\n     Но кто-то упорно вёл меня к свету.\n     Поначалу мне было больно.\n\n     Теперь больше не больно."
    },
    {
      "pattern": "\\ALost\\ in\\ Vivo\\ \\\n\\\n\\\n\\\n\\\n\\\nA\\ game\\ by\\ \\\n\\\nAKUMA\\ KIRA\\\n\\\n\\\n\\\n\\\n\\\n3D\\ art\\ by\\\n\\\nSOTIRIS\\\n\\\n\\\n\\\n\\\n\\\nMusic\\ by\\ \\\n\\\nAKUMA\\ KIRA\\\nJARREN\\ CRIST\\\nNOLAN\\ REESE\\\n\\\n\\\n\\\n\\\n\\\nTextures\\ and\\ lighting\\ by\\\n\\\nGL\\ LABS\\\n\\\n\\\n\\\n\\\n\\\nMotion\\ Capture\\ by\\ \\\n\\\n(?<motionUser>[^\\r\\n]+)\\\n\\\n\\\n\\\n\\\n\\\nBlood\\ by\\\n\\\n(?<bloodUser>[^\\r\\n]+)\\\n\\\n\\\n\\\n\\\n\\\nThe\\ time\\\n\\\nIS\\ LATE\\\n\\\n\\\n\\\n\\\n\\\nSavior\\ of\\ rats\\\n\\\nSOTIRIS\\\n\\\n\\\n\\\n\\\n\\\nThe\\ need\\\n\\\nFOR\\ EYES\\\n\\\n\\\n\\\nIs\\ an\\ unquenchable\\\n\\\nHUNGER\\z",
      "replacement": "Затерянный в себе \n\n\n\n\n\nАвтор игры: \n\nAKUMA KIRA\n\n\n\n\n\n3D-графика:\n\nSOTIRIS\n\n\n\n\n\nМузыка: \n\nAKUMA KIRA\nJARREN CRIST\nNOLAN REESE\n\n\n\n\n\nТекстуры и освещение:\n\nGL LABS\n\n\n\n\n\nЗахват движений: \n\n${motionUser}\n\n\n\n\n\nКровь:\n\n${bloodUser}\n\n\n\n\n\nВремя\n\nНА ИСХОДЕ\n\n\n\n\n\nСпаситель крыс\n\nSOTIRIS\n\n\n\n\n\nЖажда\n\nГЛАЗ\n\n\n\n— это неутолимый\n\nГОЛОД"
    },
    {
      "pattern": "\\A[ \\t]*A\\ game\\ by[ \\t]*\\z",
      "replacement": "Автор игры:"
    },
    {
      "pattern": "\\A[ \\t]*3D\\ art\\ by[ \\t]*\\z",
      "replacement": "3D-графика:"
    },
    {
      "pattern": "\\A[ \\t]*Music\\ by[ \\t]*\\z",
      "replacement": "Музыка:"
    },
    {
      "pattern": "\\A[ \\t]*Textures\\ and\\ lighting\\ by[ \\t]*\\z",
      "replacement": "Текстуры и освещение:"
    },
    {
      "pattern": "\\A[ \\t]*Motion\\ Capture\\ by[ \\t]*\\z",
      "replacement": "Захват движений:"
    },
    {
      "pattern": "\\A[ \\t]*Blood\\ by[ \\t]*\\z",
      "replacement": "Кровь:"
    }
  ]
}
